# ============================================
# Node.js / JavaScript / TypeScript
# ============================================

# Dependencies
node_modules/
.npm/
.yarn/
.pnpm-store/

# Task CLI (local developer tooling; not committed)
.tools/
.task/

# Environment variables
.env
.env.*
!.env.example
!.env.template
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs (the root build/ directory is tracked orchestration and is
# re-included at the bottom of this file)
dist/
out/
.next/
.nuxt/
.output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.bsconfig.json

# ============================================
# Prisma / Database
# ============================================

# Prisma generated client
prisma/generated/
src/prisma/generated/
*.generated.*

# SQLite databases (if using SQLite)
*.db
*.sqlite
*.sqlite3

# ============================================
# React Native / Expo / Mobile
# ============================================

# Native builds (if you ever eject)
android/
ios/
Pods/
*.xcworkspace
*.xcuserstate
*.xcuserdatad
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Expo
.expo/
dist/
web-build/

# ============================================
# 🧪 Testing & Coverage
# ============================================

# Coverage
coverage/
.nyc_output/
*.lcov
*.lcov.info

# Test artifacts
__tests__/__snapshots__/

# ============================================
# Deployment & Temp files
# ============================================

# Temporary files
tmp/
temp/
planning/
*.tmp
*.temp

# Uploads
uploads/
media/
*.upload.*

# ============================================
# 🔐 Security
# ============================================

# Secrets and keys
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ============================================
# Monorepo Specific
# ============================================

# Individual workspace .npmrc (should not be committed)
**/.npmrc
!**/.npmrc.example

# Workspace-specific build outputs
**/dist/
**/build/
**/.expo/
**/coverage/
**/node_modules/

# ============================================
# 🖥️ Backend Specific
# ============================================

# Backend logs
src/backend/logs/
src/backend/*.log

# Backend temp files
src/backend/tmp/
src/backend/temp/

# ============================================
# Mobile Specific
# ============================================

# Mobile build outputs
src/mobile/dist/
src/mobile/web-build/
src/mobile/.expo/

# Mobile native builds (if ejected)
src/mobile/android/
src/mobile/ios/

# ============================================
# Infrastructure / Docker
# ============================================

# Docker volumes (if using local volumes)
volumes/
*.volume/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Ansible
*.retry
*.log

# ============================================
# Repository orchestration (tracked despite the generic build-output ignores)
# ============================================
!build/
!build/Taskfile.yml
!build/tasks/
!build/tasks/*.yml
!build/scripts/
!build/scripts/**

# Kubernetes
*.kubeconfig
kubeconfig
tickets/.generated/
tickets/drafts/
tickets/exports/
tickets/reviews/
