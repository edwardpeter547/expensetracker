# ExpenseTracker mobile connectivity configuration.
#
# EXPO_PUBLIC_API_URL is the single explicit override. Leave it empty for local
# development; the app then derives the backend host from Metro (or uses
# localhost/10.0.2.2 on the iOS Simulator and Android Emulator respectively).
#
# Set EXPO_PUBLIC_API_URL to an https URL for staging and production builds.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=7001
EXPO_PUBLIC_APP_ENV=development

# Optional verified HTTPS URL for the AuditWallet premium plan-comparison page.
# Leave empty until the official website is live; the premium feature gate then
# shows a disabled, clearly-labelled external CTA instead of opening a dead or
# guessed link. Never point this at an unverified domain.
EXPO_PUBLIC_AUDITWALLET_PLANS_URL=
