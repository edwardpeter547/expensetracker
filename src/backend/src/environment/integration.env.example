# Real-PostgreSQL integration-test configuration.
#
# Copy this file to integration.env (gitignored). The values here describe an
# ADMINISTRATIVE connection to a disposable LOCAL PostgreSQL instance; the
# test harness creates and drops its own temporary databases.
#
# These same credentials are used by `task db:up` to create the local container
# (POSTGRES_USER/PASSWORD/DB) and by `task db:create-dev` as the server
# administration connection, so the container, the provisioning step, and the
# integration harness share one configuration. The default "postgres" role is a
# superuser and already has the CREATEDB privilege the harness requires. To use
# a dedicated least-privilege role instead, provision it once with
# `task db:provision-test`.
#
# The development application and migration roles are configured separately in
# dev.env (copy dev.env.example).
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=
POSTGRES_TEST_DB=postgres
# `task db:up` binds the local container to this same host and port.
POSTGRES_TEST_HOST=127.0.0.1
POSTGRES_TEST_PORT=5432
