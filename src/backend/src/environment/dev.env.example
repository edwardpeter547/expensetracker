# Local development environment (copy to dev.env — gitignored).
#
# This file is loaded by src/backend/src/configurations/env.config.js when
# NODE_ENV=development (or is unset). `task db:create-dev` also reads the
# POSTGRES_DEV_* and POSTGRES_MIGRATE_* values below to provision roles.
#
# Never commit real passwords or secrets. Generate values with, for example:
#   openssl rand -hex 16

# Server
PORT=3000
CLIENT_URL=http://localhost:3000

# Database — local Docker PostgreSQL (see `task db:up` and `task db:create-dev`).
# Runtime application role: least privilege (LOGIN, DML only, no CREATEDB).
DATABASE_URL=postgresql://expensetracker_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5432/expensetracker_dev

# Provisioning contract used by `task db:create-dev`.
POSTGRES_DEV_DB=expensetracker_dev
POSTGRES_DEV_USER=expensetracker_app
POSTGRES_DEV_PASSWORD=REPLACE_WITH_APP_PASSWORD
POSTGRES_MIGRATE_USER=expensetracker_migrate
POSTGRES_MIGRATE_PASSWORD=REPLACE_WITH_MIGRATE_PASSWORD

# Schema-management connection used only by the Prisma CLI (migrate dev,
# migrate deploy, migrate status). The migration role owns the schema and may
# create shadow databases; the runtime application never uses this URL.
MIGRATION_DATABASE_URL=postgresql://expensetracker_migrate:REPLACE_WITH_MIGRATE_PASSWORD@127.0.0.1:5432/expensetracker_dev

# Auth
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Application
VERIFICATION_TOKEN_EXPIRY_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=10
SERVICE_BRAND_NAME=EXPENSE TRACKER
DEVELOPER_NAME=Retep Systems
HOST_DOMAIN=localhost
PROTOCOL=http
