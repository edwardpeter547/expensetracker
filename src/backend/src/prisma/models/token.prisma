model RefreshToken {
    id              String              @id @default(cuid())
    token           String              @unique
    familyId        String              @map("family_id")
    userId          Int
    user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    // Audit fields
    expiresAt       DateTime
    isRevoked       Boolean             @default(false)
    createdAt       DateTime            @default(now())
    createdByIp     String? 
    userAgent       String?
    lastUsedAt      DateTime?

    @@index([token])
    @@index([userId])
    @@index([familyId])
    @@map("refresh_token")
}


model VerificationToken {
    id              String              @id @default(cuid())
    token           String              @unique
    userId          Int 
    user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt       DateTime
    createdAt       DateTime            @default(now())
    createdByIp     String?

    @@index([userId])
}


model PasswordResetToken {
    id              String              @id @default(cuid())
    token           String              @unique
    userId          Int
    user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt       DateTime
    usedAt          DateTime?
    createdAt       DateTime            @default(now())
    createdByIp     String?

    @@index([userId])
}
