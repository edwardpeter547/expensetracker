# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=expensetracker-api
JWT_AUDIENCE=expensetracker

# API documentation (Swagger UI and OpenAPI JSON).
# Keep disabled in production; enable explicitly only for local/approved docs.
ENABLE_API_DOCS=false

# Logging
SERVER_LOG_FILENAME=server.log
SERVER_LOG_MAXSIZE=5242880
SERVER_LOG_MAXFILE=4
ERROR_LOG_FILENAME=error.log
ERROR_LOG_MAXSIZE=5242880
ERROR_LOG_MAXFILE=4

# Localization
DEFAULT_LOCALE=en

# SMTP
SMTP_FROM=noreply@expensetracker.co.uk

# Application
VERIFICATION_TOKEN_EXPIRY_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=10
SERVICE_BRAND_NAME=EXPENSE TRACKER
DEVELOPER_NAME=Retep Systems
HOST_DOMAIN=localhost
HOST_PROTOCOL=http
