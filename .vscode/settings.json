{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.jj": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never",
        "source.sortmembers": "never"
    },
    "yaml.schemas": {
        "https://taskfile.dev/schema.json": [
            "Taskfile.yml",
            "build/Taskfile.yml",
            "build/tasks/*.yml"
        ]
    }
}
